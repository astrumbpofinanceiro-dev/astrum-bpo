APP_ENV=development
# Credencial da aplicação (membro de bpo_app, sem BYPASSRLS, não dona das tabelas)
DATABASE_URL=postgres://bpo_app_login:troque-me@localhost:5432/bpo
# Credencial dona do schema — usada só por "npm run db:migrate"
DATABASE_MIGRATION_URL=postgres://postgres:troque-me@localhost:5432/bpo
# Supabase: usar o pooler em modo transação. Usuário no pooler: bpo_app_login.<project-ref>
# Certificado da CA (Dashboard > Database > SSL), com \n no lugar das quebras de linha
DATABASE_CA_CERT=
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=troque-me
# Segredo: nunca com prefixo NEXT_PUBLIC_
SUPABASE_SECRET_KEY=troque-me
# Somente testes: superusuário de um servidor DESCARTÁVEL
TEST_DATABASE_ADMIN_URL=postgres://postgres:troque-me@localhost:5432/postgres

STORAGE_BUCKET=bpo-private
SIGNED_URL_TTL_SECONDS=300

# Publicação na Vercel
PROCESS_INLINE=true
CRON_SECRET=gere-um-valor-aleatorio-longo
DATABASE_POOL_MAX=5
